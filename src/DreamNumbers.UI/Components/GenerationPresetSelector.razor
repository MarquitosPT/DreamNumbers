@using DreamNumbers.Enums
@inject ICombinationGenerationPresetService GenerationService

<div class="mb-3">
    <label class="form-label" for="presetDropdown">Modo de Geração</label>
    <div class="dropdown">
        <button class="form-control dropdown-toggle" type="button" id="presetDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            @GetActivePresetName()
        </button>
        <ul class="dropdown-menu" aria-labelledby="presetDropdown">
            @foreach (var preset in GenerationService.Presets)
            {
                <li>
                    <button class="dropdown-item d-flex flex-column text-start @(preset.IsActive ? "active" : "")"
                            type="button" @onclick="() => SelectPreset(preset)">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@preset.Name</strong>
                            @if (preset.Mode == CombinationGenerationMode.SmartHybrid2)
                            {
                                <span class="smart-badge" title="Modo avançado com heurísticas de diversidade, penalização de repetição e DreamNumber inteligente">
                                    ⚡ Avançado
                                </span>
                            }
                            else if (preset.IsPreset)
                            {
                                <span class="badge bg-info text-dark ms-2">Preset</span>
                            }
                        </div>
                        <small class="text-muted">@preset.Description</small>
                        @if (preset.Mode == CombinationGenerationMode.SmartHybrid2)
                        {
                            <ul class="advanced-details">
                                <li>Núcleo forte baseado em Top‑N</li>
                                <li>Randomização ponderada com penalização de repetição</li>
                                <li>Diversidade global entre combinações</li>
                                <li>DreamNumber inteligente (Top‑K + Weighted Random)</li>
                            </ul>
                        }
                    </button>
                </li>
                if (preset != GenerationService.Presets.Last())
                {
                    <li><hr class="dropdown-divider"></li>
                }
            }
        </ul>
    </div>
</div>

@code {
    private void SelectPreset(CombinationGenerationPreset preset)
    {
        GenerationService.SetActivePreset(preset.Name);
    }

    private string GetActivePresetName()
    {
        return GenerationService.Presets.FirstOrDefault(p => p.IsActive)?.Name ?? "Modo de Geração";
    }
}
