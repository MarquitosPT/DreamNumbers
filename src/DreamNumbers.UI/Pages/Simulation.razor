@page "/simulation"
@inject ILotterySelector LotterySelector

@if (LotterySelector.GetLottery() == Enums.LotteryGame.EuroDreams)
{
    <EuroDreamsSimulation />
}
else if (LotterySelector.GetLottery() == Enums.LotteryGame.EuroMillions)
{
    <EuroMillionsSimulation />
}
else
{
    <div class="alert alert-warning" role="alert">
        Por favor, selecione uma lotaria válida para visualizar a simulação.
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        LotterySelector.SetVisible(true);
        LotterySelector.OnLotteryChanged += OnLotteryChanged;
    }
    private void OnLotteryChanged(Enums.LotteryGame newLottery)
    {
        InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        LotterySelector.OnLotteryChanged -= OnLotteryChanged;
    }
}
