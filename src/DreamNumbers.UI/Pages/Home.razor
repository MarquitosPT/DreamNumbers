@page "/"
@using DreamNumbers.UI.Services
@inject IDrawStorage DrawStorage
@inject IFormFactor FormFactor

<PageTitle>Bem-vindo</PageTitle>

<div class="home-container">

    <section class="welcome pb-3">
        <h1>Bem-vindo</h1>
        <p>
            O DreamNumbers é um projeto open-source dedicado à análise inteligente
            dos resultados do EuroDreams.
            Aqui podes explorar estatísticas,
            acompanhar tendências e descobrir padrões interessantes nos sorteios.
        </p>
        <div class="alert alert-info">
            Navega pelo menu para acessar as diferentes funcionalidades, como o histórico de sorteios, estatísticas detalhadas e o simulador de combinações.
        </div>
    </section>

    <section class="latest-draw pb-3">
        <h4>Último sorteio</h4>
        <p>Confere aqui a chave do último sorteio do EuroDreams.</p>
        <LastDrawCard Draw="@lastDraw" />
    </section>

    @if (isWeb)
    {
        <section>
            <div class="row">
                <div class="col-auto">
                    <div class="alert alert-success">
                        <h4 class="alert-heading">Aplicação Disponível!</h4>
                        <p>Dream Numbers também está disponível na Microsoft Store.<br /> Descarrega a aplicação hoje mesmo.</p>
                        <a class="alert-link" href="https://apps.microsoft.com/detail/9N84KQ7G3QB5" target="_blank" rel="noopener noreferrer">
                            <img src="data:image/png;base64," alt="windows-11">
                            Ver na Microsoft Store
                        </a>
                    </div>
                </div>
            </div>
        </section>
    }


</div>

@code {
    private Draw? lastDraw;
    private bool isWeb;

    protected override async Task OnInitializedAsync()
    {
        isWeb = (FormFactor.GetFormFactor() == "Web");
        lastDraw = await DrawStorage.GetLastDrawAsync();
    }
}
