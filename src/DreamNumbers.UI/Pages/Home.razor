@page "/"
@using DreamNumbers.UI.Services
@inject ILotterySelector LotterySelector
@inject IFormFactor FormFactor
@inject IDrawStorage DrawStorage
@inject IEuroMillionDrawStorage EuroMillionDrawStorage

<div class="home-container">

    <section class="welcome pb-3">
        <h1>Bem-vindo</h1>
        <p>
            O DreamNumbers é um projeto open-source dedicado à análise inteligente
            dos resultados do EuroDreams e do EuroMilhões.
            Aqui pode explorar estatísticas,
            acompanhar tendências e descobrir padrões interessantes nos sorteios.
        </p>
        <div class="alert alert-info">
            Navegue pelo menu para aceder as diferentes funcionalidades, como o histórico de sorteios, estatísticas detalhadas e o simulador de combinações.
        </div>
    </section>

    @if (LotterySelector.GetLottery() == Enums.LotteryGame.EuroDreams)
    {
        <PageTitle>Bem-vindo - EuroDreams</PageTitle>

        @if (lastDraw != null)
        {
            <section class="last-draw pb-3">
                <h3>Último sorteio</h3>
                <p>Confira aqui a chave do último sorteio do EuroDreams.</p>
                <LastDrawCard Draw="@lastDraw" />
            </section>
        }
    }
    else if (LotterySelector.GetLottery() == Enums.LotteryGame.EuroMillions)
    {
        <PageTitle>Bem-vindo - EuroMilhões</PageTitle>

        @if (lastEuroMillionDraw != null)
        {
            <section class="last-draw pb-3">
                <h3>Último sorteio</h3>
                <p>Confira aqui a chave do último sorteio do EuroMilhões.</p>
                <LastEuroMillionDrawCard Draw="@lastEuroMillionDraw" />
            </section>
        }
    }
    else
    {
        <PageTitle>Bem-vindo</PageTitle>

        <section class="last-draw pb-3">
            <div class="alert alert-warning" role="alert">
                Por favor, selecione uma lotaria válida para visualizar o último sorteio.
            </div>
        </section>
    }

    @if (isWeb)
    {
        <section>
            <div class="row">
                <div class="col-auto">
                    <div class="alert alert-success">
                        <h4 class="alert-heading">Aplicação Disponível!</h4>
                        <p>Dream Numbers também está disponível na Microsoft Store.<br /> Descarregue a aplicação hoje mesmo.</p>
                        <a class="alert-link" href="https://apps.microsoft.com/detail/9N84KQ7G3QB5" target="_blank" rel="noopener noreferrer">
                            <img src="data:image/png;base64," alt="windows-11">
                            Ver na Microsoft Store
                        </a>
                    </div>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private bool isWeb;
    private Draw? lastDraw;
    private EuroMillionDraw? lastEuroMillionDraw;

    protected override async Task OnInitializedAsync()
    {
        LotterySelector.SetVisible(true);
        LotterySelector.OnLotteryChanged += OnLotteryChanged;

        lastDraw = await DrawStorage.GetLastDrawAsync();
        lastEuroMillionDraw = await EuroMillionDrawStorage.GetLastDrawAsync();

        isWeb = (FormFactor.GetFormFactor() == "Web");
    }

    private void OnLotteryChanged(Enums.LotteryGame newLottery)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LotterySelector.OnLotteryChanged -= OnLotteryChanged;
    }
}
